# Receiver HTTP
PORT=8787
HOST=0.0.0.0

# Segurança de entrada
# HMAC que deve bater com x-pedefacil-signature (mesmo valor do webhook_secret da loja)
PEDEFACIL_SIGNATURE_SECRET=

# Token opcional para proteger o endpoint (Authorization: Bearer <token>)
PEDEFACIL_RECEIVER_TOKEN=

# Modo de saída: webhook | evolution | zapi | log
OUTBOUND_MODE=webhook

# Modo webhook
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_AUTH=

# Modo evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Modo zapi
# Coloque URL completa do endpoint de envio de texto
ZAPI_URL=
ZAPI_TOKEN=
