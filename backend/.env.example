# Java receiver local config
PORT=8081
PEDEFACIL_RECEIVER_TOKEN=
PEDEFACIL_SIGNATURE_SECRET=

# log | webhook | evolution | zapi
OUTBOUND_MODE=log

# webhook mode
AUTOMATION_OUTBOUND_URL=
AUTOMATION_OUTBOUND_BEARER_TOKEN=

# evolution mode
AUTOMATION_EVOLUTION_BASE_URL=
AUTOMATION_EVOLUTION_API_KEY=
AUTOMATION_EVOLUTION_INSTANCE=

# zapi mode
AUTOMATION_ZAPI_BASE_URL=https://api.z-api.io
AUTOMATION_ZAPI_INSTANCE=
AUTOMATION_ZAPI_TOKEN=

# pagamentos
PAYMENTS_API_PUBLIC_BASE_URL=
PAYMENTS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
PAYMENTS_CHECKOUT_RATE_LIMIT_MAX=20
PAYMENTS_CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60
PAYMENTS_REVALIDATE_RATE_LIMIT_MAX=30
PAYMENTS_REVALIDATE_RATE_LIMIT_WINDOW_SECONDS=60
# Token global (usado para checkout/revalidacao de PLANOS da plataforma)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_TOKEN=
MERCADOPAGO_RETRY_MAX_ATTEMPTS=3
MERCADOPAGO_RETRY_BASE_DELAY_MS=250
