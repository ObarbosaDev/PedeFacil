# zapi mode
AUTOMATION_ZAPI_BASE_URL=https://api.z-api.io
AUTOMATION_ZAPI_INSTANCE=
AUTOMATION_ZAPI_TOKEN=

# pagamentos
PAYMENTS_API_PUBLIC_BASE_URL=
