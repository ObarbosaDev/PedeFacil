# Java receiver local config
PORT=8081
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
FLYWAY_ENABLED=true
APP_BASE_URL=http://localhost:5173
APP_AUTH_JWT_SECRET=
APP_AUTH_ACCESS_TOKEN_MINUTES=30
APP_AUTH_REFRESH_TOKEN_DAYS=30
APP_AUTH_EMAIL_VERIFICATION_TOKEN_HOURS=24
APP_AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
APP_AUTH_DEBUG_EXPOSE_TOKENS=false
PEDEFACIL_RECEIVER_TOKEN=
PEDEFACIL_SIGNATURE_SECRET=

# log | webhook | evolution | zapi
